# Copy to .env and fill in. Never commit the real .env.

# Bedrock — current-generation inference-profile IDs only
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REVIEWER_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Third voice in the swarm trio (adversarial reviewer). Optional; defaults to the reviewer.
# A family that rejects tool use in streaming mode (Llama/Mistral) needs streaming=False in
# graph.py's third-model build; the default Claude/Nova trio streams fine.
BEDROCK_THIRD_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMS=1024

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# ada credential refresh (used by scripts/refresh-creds.sh)
ADA_ACCOUNT=000000000000
ADA_ROLE=IibsAdminAccess-DO-NOT-DELETE
ADA_PROVIDER=conduit
